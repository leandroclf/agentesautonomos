# Configurações de produção AWS
# Este arquivo deve ser configurado com valores reais de produção

# Configurações AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SQS Real (AWS)
SQS_ENDPOINT=
SQS_REGION=us-east-1
SQS_QUEUE_EVENT_PROCESSING=agentes-event-processing-prod
SQS_QUEUE_AGENT_COMMUNICATION=agentes-agent-communication-prod
SQS_QUEUE_TASK_DISTRIBUTION=agentes-task-distribution-prod
SQS_QUEUE_NOTIFICATION=agentes-notification-prod
SQS_QUEUE_DEAD_LETTER=agentes-dead-letter-prod

# S3 Real (AWS)
AWS_S3_BUCKET=agentes-storage-prod
AWS_S3_REGION=us-east-1

# RDS PostgreSQL (AWS)
DB_HOST=
DB_PORT=5432
DB_NAME=agentes_autonomos_prod
DB_USER=
DB_PASSWORD=
DB_SSL=true
DB_POOL_MIN=5
DB_POOL_MAX=20

# ElastiCache Redis (AWS)
REDIS_ENABLED=true
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=agentes:prod:
REDIS_TTL=3600
REDIS_RETRY_DELAY=1000
REDIS_MAX_RETRIES=3
REDIS_HEALTH_CHECK_INTERVAL=30000
REDIS_TLS=true

# Configurações de aplicação
NODE_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/var/log/agentes

# Configurações de segurança
ENABLE_CORS=false
CORS_ORIGIN=https://agentes.yourdomain.com
ENABLE_SWAGGER=false
API_RATE_LIMIT=1000
API_RATE_WINDOW=900000

# Configurações de monitoramento
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Configurações de métricas
ENABLE_METRICS=true
METRICS_PORT=9091
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=30000

# Configurações de timeout
REQUEST_TIMEOUT=30000
AGENT_TIMEOUT=60000
SQS_VISIBILITY_TIMEOUT=300
SQS_MESSAGE_RETENTION=1209600

# URLs dos agentes (produção)
EXTERNAL_GATEWAY_PORT=3001
EXTERNAL_GATEWAY_HOST=0.0.0.0
INTERFACE_AGENT_URL=http://interface-agent:3002
EVENT_AGENT_URL=http://event-agent:3003
PLANNING_AGENT_URL=http://planning-agent:3004
EXECUTION_AGENT_URL=http://execution-agent:3005
MONITORING_AGENT_URL=http://monitoring-agent:3006
LEARNING_AGENT_URL=http://learning-agent:3007
COORDINATION_AGENT_URL=http://coordination-agent:3008
RESOURCE_AGENT_URL=http://resource-agent:3009
SECURITY_AGENT_URL=http://security-agent:3010
CONTEXT_AGENT_URL=http://context-agent:3011

# Configurações de backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Configurações de alertas
ALERT_EMAIL=
ALERT_SLACK_WEBHOOK=
ALERT_THRESHOLD_CPU=80
ALERT_THRESHOLD_MEMORY=85
ALERT_THRESHOLD_DISK=90