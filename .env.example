# Configurações de Ambiente - Agentes Autônomos
# Copie este arquivo para .env e configure os valores apropriados

# Ambiente de Execução
NODE_ENV=development
PORT=3000

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# SQS Queues - Core Agents
SQS_INTERFACE_AGENT_QUEUE=interface-agent-queue-dev
SQS_EVENT_AGENT_QUEUE=event-agent-queue-dev
SQS_PLANNING_AGENT_QUEUE=planning-agent-queue-dev
SQS_EXECUTION_AGENT_QUEUE=execution-agent-queue-dev
SQS_STATE_AGENT_QUEUE=state-agent-queue-dev
SQS_OBSERVABILITY_AGENT_QUEUE=observability-agent-queue-dev

# SQS Queues - Auxiliary Agents
SQS_MONITORING_AGENT_QUEUE=monitoring-agent-queue-dev
SQS_SECURITY_AGENT_QUEUE=security-agent-queue-dev
SQS_POLICY_AGENT_QUEUE=policy-agent-queue-dev

# SQS Queues - Future Agents (Phase 3+)
SQS_MEDIATION_AGENT_QUEUE=mediation-agent-queue-dev
SQS_LEARNING_AGENT_QUEUE=learning-agent-queue-dev
SQS_RECOVERY_AGENT_QUEUE=recovery-agent-queue-dev
SQS_PERSISTENCE_AGENT_QUEUE=persistence-agent-queue-dev
SQS_ENRICHMENT_AGENT_QUEUE=enrichment-agent-queue-dev
SQS_LIFECYCLE_AGENT_QUEUE=lifecycle-agent-queue-dev
SQS_EXTERNAL_API_GATEWAY_QUEUE=external-api-gateway-queue-dev

# Dead Letter Queues (DLQ)
SQS_DLQ_SUFFIX=-dlq
SQS_DLQ_MAX_RECEIVE_COUNT=3

# SQS Polling Configuration
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME=20
SQS_VISIBILITY_TIMEOUT=300

# SQS Retry Configuration
SQS_MAX_RETRY_ATTEMPTS=3
SQS_BACKOFF_MULTIPLIER=2
SQS_INITIAL_DELAY=1000

# Agent Ports
EVENT_AGENT_PORT=3003
PLANNING_AGENT_PORT=3004
EXECUTION_AGENT_PORT=3005
MONITORING_AGENT_PORT=3006
SECURITY_AGENT_PORT=3007
POLICY_AGENT_PORT=3008

# Event Agent Configuration
EVENT_MAX_SIZE=5mb
EVENT_TIMEOUT=15000
EVENT_RETRY_ATTEMPTS=3
EVENT_RETRY_DELAY=1000

# Planning Agent Configuration
PLANNING_MAX_COMPLEXITY=100
PLANNING_TIMEOUT=60000
PLANNING_CACHE_ENABLED=true
PLANNING_CACHE_TIMEOUT=300000

# Execution Agent Configuration
EXECUTION_MAX_CONCURRENT=10
EXECUTION_TIMEOUT=300000
EXECUTION_RETRY_ATTEMPTS=3
EXECUTION_RETRY_DELAY=2000

# Monitoring Agent Configuration
MONITORING_METRICS_INTERVAL=60000
MONITORING_ERROR_RATE_THRESHOLD=0.05
MONITORING_RESPONSE_TIME_THRESHOLD=5000
MONITORING_MEMORY_THRESHOLD=0.8
MONITORING_CPU_THRESHOLD=0.8
MONITORING_QUEUE_DEPTH_THRESHOLD=100
MONITORING_RETENTION_PERIOD=604800000

# Security Agent Configuration
SECURITY_SESSION_TIMEOUT=3600000
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_DURATION=900000
SECURITY_TOKEN_CLEANUP_INTERVAL=3600000

# Policy Agent Configuration
POLICY_CACHE_TIMEOUT=300000
POLICY_MAX_VIOLATION_HISTORY=1000
POLICY_AUDIT_RETENTION=2592000000

# Mock APIs (Anti-Deadlock - Phase 1)
MOCK_POLICY_API_URL=http://localhost:3001
MOCK_STATE_API_URL=http://localhost:3002
MOCK_SCHEMA_REGISTRY_URL=http://localhost:3003

# Real APIs (Phase 4+)
POLICY_API_URL=https://api.policy.internal
STATE_API_URL=https://api.state.internal
SCHEMA_REGISTRY_URL=https://schema.registry.internal

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agentes_autonomos
DB_USER=postgres
DB_PASSWORD=your_db_password

# Redis Configuration (Cache/Session)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Observability
METRICS_PORT=9090
PROMETHEUS_ENDPOINT=/metrics
LOG_LEVEL=info
LOG_FORMAT=json

# Security
JWT_SECRET=your_jwt_secret_here
API_KEY_HEADER=X-API-Key
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Kubernetes
K8S_NAMESPACE=agentes-autonomos
K8S_SERVICE_ACCOUNT=agentes-sa

# Health Checks
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# MARL Configuration
MARL_LEARNING_RATE=0.01
MARL_DISCOUNT_FACTOR=0.95
MARL_EXPLORATION_RATE=0.1
MARL_UPDATE_FREQUENCY=100