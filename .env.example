# =============================================================================
# CONFIGURAÇÃO DOS AGENTES AUTÔNOMOS
# =============================================================================

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO GERAL
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# INTERFACE AGENT (Porta 3000)
# -----------------------------------------------------------------------------
INTERFACE_AGENT_PORT=3000
INTERFACE_AGENT_HOST=localhost
INTERFACE_AGENT_NAME=interface

# -----------------------------------------------------------------------------
# EVENT AGENT (Porta 3001)
# -----------------------------------------------------------------------------
EVENT_AGENT_PORT=3001
EVENT_AGENT_HOST=localhost
EVENT_AGENT_NAME=event

# -----------------------------------------------------------------------------
# PLANNING AGENT (Porta 3002)
# -----------------------------------------------------------------------------
PLANNING_AGENT_PORT=3002
PLANNING_AGENT_HOST=localhost
PLANNING_AGENT_NAME=planning

# -----------------------------------------------------------------------------
# EXECUTION AGENT (Porta 3003)
# -----------------------------------------------------------------------------
EXECUTION_AGENT_PORT=3003
EXECUTION_AGENT_HOST=localhost
EXECUTION_AGENT_NAME=execution

# -----------------------------------------------------------------------------
# AWS/SQS CONFIGURAÇÃO
# -----------------------------------------------------------------------------
# Para desenvolvimento local (ElasticMQ)
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:9324

# Para produção AWS (descomente e configure)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# SQS_ENDPOINT=https://sqs.us-east-1.amazonaws.com

# -----------------------------------------------------------------------------
# FILAS SQS
# -----------------------------------------------------------------------------
SQS_INTERFACE_EVENTS_QUEUE=interface-events
SQS_EVENT_PROCESSING_QUEUE=event-processing
SQS_PLANNING_REQUESTS_QUEUE=planning-requests
SQS_EXECUTION_REQUESTS_QUEUE=execution-requests
SQS_NOTIFICATIONS_QUEUE=notifications
SQS_STATUS_UPDATES_QUEUE=status-updates

# Dead Letter Queues
SQS_INTERFACE_EVENTS_DLQ=interface-events-dlq
SQS_EVENT_PROCESSING_DLQ=event-processing-dlq
SQS_PLANNING_REQUESTS_DLQ=planning-requests-dlq
SQS_EXECUTION_REQUESTS_DLQ=execution-requests-dlq

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DE MÉTRICAS E MONITORAMENTO
# -----------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_PORT=9464
METRICS_PATH=/metrics
HEALTH_CHECK_INTERVAL=30000

# Prometheus
PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_HOST=localhost
GRAFANA_PORT=3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DE SEGURANÇA
# -----------------------------------------------------------------------------
# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=*
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Security Headers
SECURITY_HEADERS_ENABLED=true

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DE PERFORMANCE
# -----------------------------------------------------------------------------
# Worker Pool
WORKER_POOL_SIZE=4
WORKER_POOL_MAX_QUEUE_SIZE=1000
WORKER_POOL_TIMEOUT=300000

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=60000
CIRCUIT_BREAKER_MONITOR_TIMEOUT=30000

# Retry Configuration
RETRY_MAX_ATTEMPTS=3
RETRY_DELAY_MS=1000
RETRY_BACKOFF_FACTOR=2

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DE CACHE E PERSISTÊNCIA
# -----------------------------------------------------------------------------
# Cache TTL (em segundos)
CACHE_TTL_EVENTS=3600
CACHE_TTL_PLANS=7200
CACHE_TTL_EXECUTIONS=1800

# Cleanup intervals (em milissegundos)
CLEANUP_INTERVAL_EVENTS=3600000
CLEANUP_INTERVAL_PLANS=7200000
CLEANUP_INTERVAL_EXECUTIONS=1800000

# Data retention (em dias)
DATA_RETENTION_EVENTS=7
DATA_RETENTION_PLANS=30
DATA_RETENTION_EXECUTIONS=14

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DE DESENVOLVIMENTO
# -----------------------------------------------------------------------------
# Hot reload
HOT_RELOAD_ENABLED=true

# Debug
DEBUG_ENABLED=false
DEBUG_NAMESPACE=agents:*

# Mock services
MOCK_SERVICES_ENABLED=false
MOCK_DELAY_MS=100

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DE PRODUÇÃO
# -----------------------------------------------------------------------------
# Clustering
CLUSTER_ENABLED=false
CLUSTER_WORKERS=0

# SSL/TLS
SSL_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# Database (se necessário no futuro)
# DATABASE_URL=postgresql://user:password@localhost:5432/agents
# DATABASE_POOL_SIZE=10
# DATABASE_TIMEOUT=30000

# Redis (se necessário no futuro)
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DE NOTIFICAÇÕES
# -----------------------------------------------------------------------------
# Email (se necessário)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Slack (se necessário)
# SLACK_WEBHOOK_URL=
# SLACK_CHANNEL=#alerts

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DE OBSERVABILIDADE AVANÇADA
# -----------------------------------------------------------------------------
# Tracing
TRACING_ENABLED=false
TRACING_SERVICE_NAME=autonomous-agents
TRACING_ENDPOINT=

# APM
APM_ENABLED=false
APM_SERVICE_NAME=autonomous-agents
APM_ENVIRONMENT=development

# Error Tracking
ERROR_TRACKING_ENABLED=false
ERROR_TRACKING_DSN=