# Configurações para Produção
NODE_ENV=production

# Portas dos Agentes
INTERFACE_AGENT_PORT=3000
EVENT_AGENT_PORT=3001
PLANNING_AGENT_PORT=3002
EXECUTION_AGENT_PORT=3003
STATE_AGENT_PORT=3004

# AWS Produção
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=<configurar via IAM Role ou Secrets Manager>
# AWS_SECRET_ACCESS_KEY=<configurar via IAM Role ou Secrets Manager>

# Filas SQS (Produção)
EVENT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/event-agent-queue-prod
PLANNING_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/planning-agent-queue-prod
EXECUTION_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/execution-agent-queue-prod
STATE_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/state-agent-queue-prod

# Dead Letter Queues
EVENT_DLQ_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/event-agent-queue-prod-dlq
PLANNING_DLQ_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/planning-agent-queue-prod-dlq
EXECUTION_DLQ_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/execution-agent-queue-prod-dlq

# Storage
S3_BUCKET=agentes-storage-prod

# Logs
LOG_LEVEL=warn
LOG_FORMAT=json
LOG_FILE=/var/log/agentes/production.log

# Monitoramento
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
METRICS_ENABLED=true
METRICS_PORT=9464

# APIs Externas (Produção)
POLICY_API_URL=https://api.policy.company.com
SCHEMA_REGISTRY_URL=https://schema-registry.company.com
STATE_API_URL=https://state-api.company.com

# Timeouts (ms)
HTTP_TIMEOUT=10000
SQS_VISIBILITY_TIMEOUT=60
SQS_WAIT_TIME=20

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# CORS
CORS_ORIGIN=https://app.company.com,https://admin.company.com
CORS_CREDENTIALS=true

# Health Check
HEALTH_CHECK_INTERVAL=60000
HEALTH_CHECK_TIMEOUT=10000

# Security
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/agentes.crt
SSL_KEY_PATH=/etc/ssl/private/agentes.key

# Clustering
CLUSTER_MODE=true
WORKER_PROCESSES=auto