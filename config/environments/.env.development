# Configurações para Desenvolvimento Local
NODE_ENV=development

# Portas dos Agentes
INTERFACE_AGENT_PORT=3000
EVENT_AGENT_PORT=3001
PLANNING_AGENT_PORT=3002
EXECUTION_AGENT_PORT=3003
STATE_AGENT_PORT=3004

# AWS LocalStack
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
S3_ENDPOINT=http://localhost:4566

# Filas SQS (LocalStack)
EVENT_QUEUE_URL=http://localhost:4566/000000000000/event-agent-queue-dev
PLANNING_QUEUE_URL=http://localhost:4566/000000000000/planning-agent-queue-dev
EXECUTION_QUEUE_URL=http://localhost:4566/000000000000/execution-agent-queue-dev
STATE_QUEUE_URL=http://localhost:4566/000000000000/state-agent-queue-dev

# Dead Letter Queues
EVENT_DLQ_URL=http://localhost:4566/000000000000/event-agent-queue-dev-dlq
PLANNING_DLQ_URL=http://localhost:4566/000000000000/planning-agent-queue-dev-dlq
EXECUTION_DLQ_URL=http://localhost:4566/000000000000/execution-agent-queue-dev-dlq

# Storage
S3_BUCKET=agentes-storage-dev

# Logs
LOG_LEVEL=debug
LOG_FORMAT=dev
LOG_FILE=logs/development.log

# Monitoramento
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
METRICS_ENABLED=true
METRICS_PORT=9464

# APIs Externas (Mocks)
POLICY_API_URL=http://localhost:8001
SCHEMA_REGISTRY_URL=http://localhost:8002
STATE_API_URL=http://localhost:8003

# Timeouts (ms)
HTTP_TIMEOUT=5000
SQS_VISIBILITY_TIMEOUT=30
SQS_WAIT_TIME=20

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# Health Check
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000