{
  "name": "agentes-autonomos-multiagent-sqs",
  "version": "1.0.0",
  "description": "Arquitetura Multiagente baseada em Amazon SQS com Event-Driven Architecture (EDA) + MARL",
  "main": "src/index.js",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:system": "node scripts/test-system-integration.js",
    "test:coverage": "jest --coverage",
    "test:sqs": "node scripts/test-sqs-connectivity.js",
    "dev": "node scripts/start-dev-environment.js start",
    "dev:stop": "node scripts/start-dev-environment.js stop",
    "dev:legacy": "node scripts/setup-complete-dev-environment.js",
    "dev:quick": "node scripts/dev.js quick",
    "dev:test": "node scripts/dev.js test",
    "dev:clean": "node scripts/dev.js clean",
    "start:all": "concurrently \"npm run start:state\" \"npm run start:interface\" \"npm run start:event\" \"npm run start:planning\" \"npm run start:execution\"",
    "start:state": "node src/agents/core/state-management-agent/start.js",
    "start:interface": "node src/agents/core/interface-agent/index.js",
    "start:event": "node src/agents/core/event-agent/index.js",
    "start:planning": "node src/agents/core/planning-agent/index.js",
    "start:execution": "node src/agents/core/execution-agent/index.js",
    "setup:aws-production": "node scripts/setup-aws-production.js",
    "switch-to-real-sqs": "node scripts/switch-to-real-sqs.js",
    "implement:handlers": "node scripts/implement-missing-handlers.js",
    "setup:documentation": "node scripts/setup-documentation.js",
    "docs:serve": "npx http-server docs -p 8080 -o",
    "docs:build": "echo 'Documentation is ready in docs/ folder'",
    "docs:validate": "powershell -Command \"Get-ChildItem -Path docs -Recurse -Filter '*.md' | ForEach-Object { Write-Host 'Validating' $_.FullName }\"",
    "aws:setup": "node deploy/aws/setup.js",
    "aws:verify": "node deploy/aws/verify.js",
    "localstack:up": "cd infrastructure/localstack && docker-compose up -d",
    "localstack:down": "cd infrastructure/localstack && docker-compose down",
    "localstack:setup": "powershell infrastructure/localstack/setup.ps1",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build": "docker-compose build",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write src/**/*.js",
    "clean": "rimraf logs/* temp/* coverage/",
    "monitor:start": "node src/monitoring/start-monitoring.js",
    "logs:view": "tail -f logs/system/combined.log",
    "logs:errors": "tail -f logs/errors/error.log"
  },
  "keywords": [
    "multiagent",
    "sqs",
    "event-driven",
    "marl",
    "microservices",
    "aws",
    "kubernetes"
  ],
  "author": "Equipe de Arquitetura",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.450.0",
    "aws-sdk": "^2.1490.0",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-prometheus-middleware": "^1.2.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "prom-client": "^13.2.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.54.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seu-usuario/agentes-autonomos.git"
  },
  "bugs": {
    "url": "https://github.com/seu-usuario/agentes-autonomos/issues"
  },
  "homepage": "https://github.com/seu-usuario/agentes-autonomos#readme",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js",
      "!src/config/*.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "eslintConfig": {
    "extends": [
      "standard"
    ],
    "env": {
      "node": true,
      "jest": true
    },
    "rules": {
      "no-console": "warn",
      "prefer-const": "error",
      "no-unused-vars": "error"
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none",
    "printWidth": 100
  }
}