# External Event API Gateway - Environment Configuration
# Copie este arquivo para .env e ajuste os valores conforme necessário

# =============================================================================
# SERVIDOR
# =============================================================================
PORT=3007
HOST=0.0.0.0
NODE_ENV=development
TIMEOUT=30000
MAX_PAYLOAD_SIZE=10mb

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/gateway.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# =============================================================================
# SEGURANÇA
# =============================================================================
TRUST_PROXY=true
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-API-Key,X-Correlation-ID

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL=false
RATE_LIMIT_SKIP_FAILED=false
RATE_LIMIT_STANDARD_HEADERS=true
RATE_LIMIT_LEGACY_HEADERS=false

# =============================================================================
# REDIS (CACHE E RATE LIMITING)
# =============================================================================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=gateway:
REDIS_TTL=3600
REDIS_RETRY_ATTEMPTS=3
REDIS_RETRY_DELAY=1000

# =============================================================================
# AWS SQS
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
SQS_ENDPOINT=https://sqs.us-east-1.amazonaws.com
# Para LocalStack (desenvolvimento):
# SQS_ENDPOINT=http://localhost:4566

# Filas SQS
SQS_RAW_EVENTS_QUEUE=raw-events-queue
SQS_INCOMING_EVENTS_QUEUE=incoming-events-queue
SQS_VALIDATION_ERRORS_QUEUE=validation-errors-queue

# Configurações de envio SQS
SQS_MESSAGE_GROUP_ID=external-gateway
SQS_DELAY_SECONDS=0
SQS_VISIBILITY_TIMEOUT=300
SQS_MESSAGE_RETENTION_PERIOD=1209600

# =============================================================================
# VALIDAÇÃO DE EVENTOS
# =============================================================================
EVENT_STRICT_VALIDATION=true
EVENT_MAX_SIZE=1048576
EVENT_REQUIRED_FIELDS=eventType,timestamp,source
EVENT_ALLOWED_TYPES=^[a-z]+\.[a-z]+$
EVENT_TIMESTAMP_TOLERANCE=300000

# =============================================================================
# TRANSFORMAÇÃO DE EVENTOS
# =============================================================================
EVENT_TRANSFORMATION_ENABLED=true
EVENT_ADD_METADATA=true
EVENT_NORMALIZE_TIMESTAMP=true
EVENT_GENERATE_ID=true
EVENT_ENRICH_CLIENT_INFO=true

# =============================================================================
# MÉTRICAS PROMETHEUS
# =============================================================================
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics
METRICS_DEFAULT_METRICS=true
METRICS_PREFIX=gateway_
METRICS_LABELS=service,version,environment

# =============================================================================
# HEALTH CHECKS
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# =============================================================================
# DESENVOLVIMENTO
# =============================================================================
DEBUG_LOGS=false
MOCK_MODE=false
TEST_ENDPOINTS=true
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false

# =============================================================================
# API KEYS PADRÃO (APENAS DESENVOLVIMENTO)
# =============================================================================
DEFAULT_API_KEYS_ENABLED=true
DEV_API_KEY=dev-key-123
TEST_API_KEY=test-key-123
ADMIN_API_KEY=admin-key-123

# =============================================================================
# MONITORAMENTO E ALERTAS
# =============================================================================
ALERT_ERROR_THRESHOLD=10
ALERT_LATENCY_THRESHOLD=1000
ALERT_WEBHOOK_URL=
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=admin@example.com

# =============================================================================
# CACHE
# =============================================================================
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_MAX_SIZE=1000
CACHE_API_KEY_TTL=3600

# =============================================================================
# COMPRESSÃO
# =============================================================================
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024

# =============================================================================
# CORS AVANÇADO
# =============================================================================
CORS_CREDENTIALS=false
CORS_MAX_AGE=86400
CORS_PREFLIGHT_CONTINUE=false
CORS_OPTIONS_SUCCESS_STATUS=204

# =============================================================================
# TIMEOUTS
# =============================================================================
REQUEST_TIMEOUT=30000
SQS_TIMEOUT=10000
REDIS_TIMEOUT=5000
HEALTH_CHECK_TIMEOUT=5000

# =============================================================================
# LIMITES
# =============================================================================
MAX_EVENTS_PER_BATCH=100
MAX_CONCURRENT_REQUESTS=1000
MAX_QUEUE_SIZE=10000
MAX_RETRY_ATTEMPTS=3

# =============================================================================
# FEATURES FLAGS
# =============================================================================
FEATURE_BATCH_PROCESSING=true
FEATURE_EVENT_TRANSFORMATION=true
FEATURE_RATE_LIMITING=true
FEATURE_METRICS=true
FEATURE_CACHING=true
FEATURE_COMPRESSION=true

# =============================================================================
# KUBERNETES (SE APLICÁVEL)
# =============================================================================
KUBERNETES_NAMESPACE=default
KUBERNETES_SERVICE_NAME=external-gateway
KUBERNETES_POD_NAME=
KUBERNETES_NODE_NAME=

# =============================================================================
# OBSERVABILIDADE
# =============================================================================
TRACING_ENABLED=false
TRACING_ENDPOINT=http://jaeger:14268/api/traces
TRACING_SERVICE_NAME=external-gateway
TRACING_SAMPLE_RATE=0.1

# =============================================================================
# BACKUP E RECOVERY
# =============================================================================
BACKUP_ENABLED=false
BACKUP_INTERVAL=3600000
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=gateway-backups

# =============================================================================
# NOTIFICAÇÕES
# =============================================================================
NOTIFICATION_ENABLED=false
NOTIFICATION_SLACK_WEBHOOK=
NOTIFICATION_DISCORD_WEBHOOK=
NOTIFICATION_TEAMS_WEBHOOK=