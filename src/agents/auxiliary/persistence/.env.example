# Persistence Agent - Configurações de Ambiente

# ===========================================
# CONFIGURAÇÕES DO SERVIDOR
# ===========================================
PORT=3016
NODE_ENV=development
LOG_LEVEL=info

# ===========================================
# AWS SQS CONFIGURAÇÕES
# ===========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
SQS_ENDPOINT=https://sqs.us-east-1.amazonaws.com

# Filas SQS
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/persistence-events
SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/123456789/persistence-events-dlq

# Configurações de Polling SQS
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME=20
SQS_VISIBILITY_TIMEOUT=300

# ===========================================
# CONFIGURAÇÕES DE DATABASE
# ===========================================

# Tipo de database principal (mongodb|postgresql|mysql)
DB_TYPE=mongodb

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=persistence_db
MONGO_USERNAME=persistence_user
MONGO_PASSWORD=persistence_password
MONGO_AUTH_SOURCE=admin
MONGO_SSL=false
MONGO_POOL_SIZE=10

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=persistence_db
POSTGRES_USERNAME=persistence_user
POSTGRES_PASSWORD=persistence_password
POSTGRES_SSL=false
POSTGRES_POOL_SIZE=10

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=persistence_db
MYSQL_USERNAME=persistence_user
MYSQL_PASSWORD=persistence_password
MYSQL_SSL=false
MYSQL_POOL_SIZE=10

# ===========================================
# CONFIGURAÇÕES DE CACHE
# ===========================================

# Cache habilitado
CACHE_ENABLED=true
CACHE_TYPE=redis

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0
REDIS_KEY_PREFIX=persistence:
REDIS_DEFAULT_TTL=3600
REDIS_MAX_MEMORY=256mb

# Cache em Memória (fallback)
MEMORY_CACHE_MAX_SIZE=1000
MEMORY_CACHE_TTL=1800

# ===========================================
# CONFIGURAÇÕES DE BACKUP
# ===========================================

# Backup habilitado
BACKUP_ENABLED=true
BACKUP_INTERVAL=3600
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true
BACKUP_COMPRESSION_LEVEL=6
BACKUP_LOCAL_PATH=./backups

# AWS S3 para Backup
BACKUP_S3_ENABLED=true
BACKUP_S3_BUCKET=persistence-backups
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=your_s3_access_key
BACKUP_S3_SECRET_KEY=your_s3_secret_key
BACKUP_S3_ENDPOINT=

# ===========================================
# CONFIGURAÇÕES DE REPLICAÇÃO
# ===========================================

# Replicação habilitada
REPLICATION_ENABLED=false
REPLICATION_MODE=master
REPLICATION_REPLICAS=2
REPLICATION_SYNC_INTERVAL=60
REPLICATION_CONFLICT_RESOLUTION=timestamp

# ===========================================
# CONFIGURAÇÕES DE PARTICIONAMENTO
# ===========================================

# Particionamento habilitado
PARTITIONING_ENABLED=false
PARTITIONING_STRATEGY=date
PARTITIONING_SIZE=1000000
PARTITIONING_AUTO=true

# ===========================================
# CONFIGURAÇÕES DE VALIDAÇÃO
# ===========================================

# Validação rigorosa
VALIDATION_STRICT_MODE=true
VALIDATION_MAX_DOCUMENT_SIZE=16777216
VALIDATION_SCHEMA_VALIDATION=true

# Campos obrigatórios
VALIDATION_REQUIRED_FIELDS=id,timestamp,type

# Tipos permitidos
VALIDATION_ALLOWED_TYPES=string,number,boolean,object,array

# ===========================================
# CONFIGURAÇÕES DE TRANSFORMAÇÃO
# ===========================================

# Transformação habilitada
TRANSFORMATION_ENABLED=true
TRANSFORMATION_ADD_METADATA=true
TRANSFORMATION_NORMALIZE_TIMESTAMP=true
TRANSFORMATION_GENERATE_ID=true
TRANSFORMATION_ENCRYPT_SENSITIVE=true

# Compressão de dados
TRANSFORMATION_COMPRESSION_ENABLED=true
TRANSFORMATION_COMPRESSION_LEVEL=6

# ===========================================
# CONFIGURAÇÕES DE SEGURANÇA
# ===========================================

# Chave de criptografia (32 caracteres)
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Algoritmo de criptografia
ENCRYPTION_ALGORITHM=aes-256-gcm

# Salt para hashing
HASH_SALT=your_hash_salt_here

# ===========================================
# CONFIGURAÇÕES DE MÉTRICAS
# ===========================================

# Métricas habilitadas
METRICS_ENABLED=true
METRICS_PORT=3016
METRICS_PATH=/metrics
METRICS_COLLECT_DEFAULT=true
METRICS_PREFIX=persistence_

# Labels das métricas
METRICS_LABELS=agent:persistence,version:1.0.0

# ===========================================
# CONFIGURAÇÕES DE HEALTH CHECK
# ===========================================

# Health check habilitado
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# Dependências para verificar
HEALTH_CHECK_DEPENDENCIES=database,cache,sqs,backup

# ===========================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# ===========================================

# Modo de desenvolvimento
DEV_MODE=true
DEV_MOCK_EXTERNAL_SERVICES=false
DEV_ENABLE_DEBUG_LOGS=true
DEV_DISABLE_AUTH=false

# Timeouts em desenvolvimento (ms)
DEV_DB_TIMEOUT=5000
DEV_CACHE_TIMEOUT=2000
DEV_SQS_TIMEOUT=10000

# ===========================================
# CONFIGURAÇÕES DE LOGS
# ===========================================

# Configurações de logging
LOG_FORMAT=json
LOG_DATE_PATTERN=YYYY-MM-DD
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
LOG_COMPRESS=true

# Diretório de logs
LOG_DIR=./logs

# Níveis de log por serviço
LOG_LEVEL_DATABASE=info
LOG_LEVEL_CACHE=info
LOG_LEVEL_BACKUP=info
LOG_LEVEL_SQS=info

# ===========================================
# CONFIGURAÇÕES DE RATE LIMITING
# ===========================================

# Rate limiting habilitado
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_SKIP_SUCCESSFUL=false

# ===========================================
# CONFIGURAÇÕES DE RETRY
# ===========================================

# Configurações de retry
RETRY_MAX_ATTEMPTS=3
RETRY_DELAY_MS=1000
RETRY_EXPONENTIAL_BACKOFF=true
RETRY_MAX_DELAY_MS=30000

# ===========================================
# CONFIGURAÇÕES DE TIMEOUT
# ===========================================

# Timeouts gerais (ms)
DATABASE_TIMEOUT=30000
CACHE_TIMEOUT=5000
SQS_TIMEOUT=30000
BACKUP_TIMEOUT=300000
HTTP_TIMEOUT=30000

# ===========================================
# CONFIGURAÇÕES DE MONITORAMENTO
# ===========================================

# Alertas
ALERT_ERROR_THRESHOLD=10
ALERT_LATENCY_THRESHOLD=5000
ALERT_QUEUE_SIZE_THRESHOLD=1000
ALERT_DISK_USAGE_THRESHOLD=80
ALERT_MEMORY_USAGE_THRESHOLD=80

# Webhook para alertas
ALERT_WEBHOOK_URL=https://your-webhook-url.com/alerts

# ===========================================
# CONFIGURAÇÕES DE TESTE
# ===========================================

# Configurações para testes
TEST_DATABASE_URL=mongodb://localhost:27017/persistence_test
TEST_REDIS_URL=redis://localhost:6379/1
TEST_SQS_ENDPOINT=http://localhost:4566
TEST_S3_ENDPOINT=http://localhost:4566

# Mock de serviços em teste
TEST_MOCK_AWS=true
TEST_MOCK_DATABASE=false
TEST_MOCK_CACHE=false