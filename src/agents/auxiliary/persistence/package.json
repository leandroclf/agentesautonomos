{
  "name": "persistence-agent",
  "version": "1.0.0",
  "description": "Agente de Persistência - Gerencia armazenamento avançado de dados e estado",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docker:build": "docker build -t persistence-agent .",
    "docker:run": "docker run -p 3016:3016 persistence-agent"
  },
  "keywords": [
    "persistence",
    "database",
    "cache",
    "backup",
    "agent",
    "microservice",
    "sqs",
    "mongodb",
    "postgresql",
    "redis"
  ],
  "author": "Sistema de Agentes Autônomos",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "prom-client": "^15.1.0",
    "aws-sdk": "^2.1490.0",
    "mongodb": "^6.3.0",
    "pg": "^8.11.3",
    "mysql2": "^3.6.5",
    "redis": "^4.6.11",
    "joi": "^17.11.0",
    "crypto": "^1.0.1",
    "zlib": "^1.0.5",
    "uuid": "^9.0.1",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "dotenv": "^16.3.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "@types/jest": "^29.5.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seu-usuario/agentes-autonomos.git"
  },
  "bugs": {
    "url": "https://github.com/seu-usuario/agentes-autonomos/issues"
  },
  "homepage": "https://github.com/seu-usuario/agentes-autonomos#readme",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!jest.config.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "eslintConfig": {
    "extends": "standard",
    "env": {
      "node": true,
      "jest": true
    },
    "rules": {
      "no-console": "warn",
      "prefer-const": "error",
      "no-unused-vars": "error"
    }
  }
}