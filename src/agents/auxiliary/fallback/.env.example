# =============================================================================
# FALLBACK AGENT - CONFIGURAÇÕES DE AMBIENTE
# =============================================================================
# Agente de Estratégias de Fallback
# Implementa circuit breaker, retry, degradação graceful e bulkhead

# =============================================================================
# CONFIGURAÇÕES DO SERVIDOR
# =============================================================================
PORT=3020
HOST=0.0.0.0
NODE_ENV=development
SERVICE_NAME=fallback-agent
SERVICE_VERSION=1.0.0

# =============================================================================
# CONFIGURAÇÕES DE LOGGING
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/fallback-agent.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
LOG_DATE_PATTERN=YYYY-MM-DD

# Debug específico
DEBUG_CIRCUIT_BREAKER=false
DEBUG_RETRY=false
DEBUG_DEGRADATION=false
DEBUG_BULKHEAD=false

# =============================================================================
# CONFIGURAÇÕES DE SEGURANÇA
# =============================================================================
# Helmet
HELMET_ENABLED=true
HELMET_CONTENT_SECURITY_POLICY=true
HELMET_HSTS_MAX_AGE=31536000

# CORS
CORS_ENABLED=true
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MESSAGE=Too many requests from this IP

# =============================================================================
# CONFIGURAÇÕES AWS SQS
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_SESSION_TOKEN=
AWS_SQS_ENDPOINT=

# Filas SQS
SQS_FALLBACK_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/fallback-events
SQS_RECOVERY_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/recovery-events
SQS_HEALTH_CHECK_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/health-check-events
SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/123456789012/fallback-dlq

# Configurações de polling
SQS_POLLING_WAIT_TIME=20
SQS_MAX_MESSAGES=10
SQS_VISIBILITY_TIMEOUT=300
SQS_MESSAGE_RETENTION_PERIOD=1209600

# Retry SQS
SQS_RETRY_ATTEMPTS=3
SQS_RETRY_DELAY=1000
SQS_RETRY_BACKOFF=exponential

# =============================================================================
# CONFIGURAÇÕES CIRCUIT BREAKER
# =============================================================================
# Configurações globais
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT=60000
CIRCUIT_BREAKER_RESET_TIMEOUT=30000
CIRCUIT_BREAKER_MONITORING_INTERVAL=5000

# Configurações por serviço (JSON)
CIRCUIT_BREAKER_SERVICES='{"external-api":{"failureThreshold":3,"timeout":30000},"database":{"failureThreshold":5,"timeout":60000}}'

# Estados iniciais
CIRCUIT_BREAKER_INITIAL_STATE=closed
CIRCUIT_BREAKER_FORCE_OPEN=false
CIRCUIT_BREAKER_FORCE_CLOSED=false

# =============================================================================
# CONFIGURAÇÕES DE RETRY
# =============================================================================
# Configurações globais
RETRY_ENABLED=true
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1000
RETRY_MAX_DELAY=30000
RETRY_BACKOFF_STRATEGY=exponential
RETRY_JITTER_ENABLED=true
RETRY_JITTER_MAX=0.1

# Timeout
RETRY_OPERATION_TIMEOUT=5000
RETRY_TOTAL_TIMEOUT=30000

# Classificação de erros
RETRY_RETRYABLE_ERRORS='["TIMEOUT","ECONNRESET","ENOTFOUND","ECONNREFUSED","500","502","503","504"]'
RETRY_NON_RETRYABLE_ERRORS='["400","401","403","404","422"]'

# Configurações por operação
RETRY_OPERATION_CONFIG='{"get_user_data":{"maxAttempts":5,"baseDelay":500},"send_notification":{"maxAttempts":2,"baseDelay":2000}}'

# =============================================================================
# CONFIGURAÇÕES DE DEGRADAÇÃO GRACEFUL
# =============================================================================
# Monitoramento de saúde
DEGRADATION_ENABLED=true
DEGRADATION_MONITORING_INTERVAL=10000
DEGRADATION_HEALTH_CHECK_INTERVAL=5000

# Thresholds do sistema
DEGRADATION_CPU_THRESHOLD=80
DEGRADATION_MEMORY_THRESHOLD=85
DEGRADATION_ERROR_RATE_THRESHOLD=10
DEGRADATION_RESPONSE_TIME_THRESHOLD=5000

# Pesos para cálculo de saúde
DEGRADATION_CPU_WEIGHT=0.3
DEGRADATION_MEMORY_WEIGHT=0.3
DEGRADATION_ERROR_RATE_WEIGHT=0.2
DEGRADATION_RESPONSE_TIME_WEIGHT=0.2

# Níveis de degradação
DEGRADATION_LEVELS='["normal","reduced","minimal"]'
DEGRADATION_AUTO_RECOVERY=true
DEGRADATION_RECOVERY_THRESHOLD=0.8
DEGRADATION_MIN_TIME_IN_LEVEL=30000

# Configurações por funcionalidade
DEGRADATION_FEATURE_CONFIG='{"data_processing":{"normal":{"enabled":true,"timeout":5000},"reduced":{"enabled":true,"timeout":10000},"minimal":{"enabled":false}},"external_apis":{"normal":{"enabled":true,"timeout":3000,"retries":3},"reduced":{"enabled":true,"timeout":5000,"retries":1},"minimal":{"enabled":false}}}'

# =============================================================================
# CONFIGURAÇÕES BULKHEAD
# =============================================================================
# Pool de recursos
BULKHEAD_ENABLED=true
BULKHEAD_DEFAULT_POOL_SIZE=10
BULKHEAD_MAX_WAIT_TIME=5000
BULKHEAD_MONITORING_INTERVAL=5000

# Configurações por serviço
BULKHEAD_SERVICE_POOLS='{"external-api":{"size":5,"maxWaitTime":3000},"database":{"size":15,"maxWaitTime":1000},"cache":{"size":3,"maxWaitTime":500}}'

# Alertas
BULKHEAD_UTILIZATION_THRESHOLD=0.8
BULKHEAD_QUEUE_SIZE_THRESHOLD=10

# =============================================================================
# CONFIGURAÇÕES DE TIMEOUT ADAPTATIVO
# =============================================================================
TIMEOUT_ADAPTIVE_ENABLED=true
TIMEOUT_BASE_TIMEOUT=5000
TIMEOUT_MIN_TIMEOUT=1000
TIMEOUT_MAX_TIMEOUT=30000

# Multiplicadores por nível de degradação
TIMEOUT_NORMAL_MULTIPLIER=1.0
TIMEOUT_REDUCED_MULTIPLIER=1.5
TIMEOUT_MINIMAL_MULTIPLIER=2.0

# Configurações por tipo de operação
TIMEOUT_OPERATION_CONFIG='{"database":{"base":2000,"max":10000},"external_api":{"base":3000,"max":15000},"cache":{"base":500,"max":2000}}'

# =============================================================================
# CONFIGURAÇÕES DE CACHE
# =============================================================================
# Cache para decisões de fallback
CACHE_ENABLED=true
CACHE_TYPE=memory
CACHE_TTL=300000
CACHE_MAX_SIZE=1000
CACHE_CHECK_PERIOD=60000

# Redis (se CACHE_TYPE=redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=fallback:
REDIS_CONNECT_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=3000

# =============================================================================
# INTEGRAÇÃO COM OUTROS AGENTES
# =============================================================================
# Recovery Agent
RECOVERY_AGENT_ENABLED=true
RECOVERY_AGENT_URL=http://localhost:3017
RECOVERY_AGENT_TIMEOUT=5000
RECOVERY_AGENT_RETRY_ATTEMPTS=2

# Health Checker Agent
HEALTH_CHECKER_AGENT_ENABLED=true
HEALTH_CHECKER_AGENT_URL=http://localhost:3015
HEALTH_CHECKER_AGENT_TIMEOUT=3000

# Persistence Agent
PERSISTENCE_AGENT_ENABLED=true
PERSISTENCE_AGENT_URL=http://localhost:3016
PERSISTENCE_AGENT_TIMEOUT=5000

# =============================================================================
# CONFIGURAÇÕES DE MÉTRICAS
# =============================================================================
# Prometheus
METRICS_ENABLED=true
METRICS_PORT=3020
METRICS_PATH=/metrics
METRICS_PREFIX=fallback_
METRICS_COLLECT_DEFAULT=true

# Métricas customizadas
METRICS_CIRCUIT_BREAKER=true
METRICS_RETRY=true
METRICS_DEGRADATION=true
METRICS_BULKHEAD=true
METRICS_PERFORMANCE=true

# Coleta de métricas
METRICS_COLLECTION_INTERVAL=5000
METRICS_RETENTION_PERIOD=3600000

# =============================================================================
# CONFIGURAÇÕES DE HEALTH CHECK
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# Dependências para verificar
HEALTH_CHECK_DEPENDENCIES='["sqs","redis","recovery-agent"]'
HEALTH_CHECK_CRITICAL_DEPENDENCIES='["sqs"]'

# Thresholds
HEALTH_CHECK_MEMORY_THRESHOLD=90
HEALTH_CHECK_CPU_THRESHOLD=95
HEALTH_CHECK_DISK_THRESHOLD=90

# =============================================================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# =============================================================================
# Modo de desenvolvimento
DEV_MODE=true
DEV_AUTO_RELOAD=true
DEV_MOCK_EXTERNAL_SERVICES=false
DEV_SIMULATE_FAILURES=false

# Testes
TEST_MODE=false
TEST_SQS_ENDPOINT=http://localhost:4566
TEST_REDIS_DB=15
TEST_TIMEOUT=10000

# =============================================================================
# CONFIGURAÇÕES DE ALERTAS
# =============================================================================
# Webhook
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
ALERT_WEBHOOK_TIMEOUT=5000
ALERT_WEBHOOK_RETRY_ATTEMPTS=2

# Email
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_SMTP_SECURE=false
ALERT_EMAIL_USER=your-email@gmail.com
ALERT_EMAIL_PASS=your-app-password
ALERT_EMAIL_FROM=fallback-agent@yourcompany.com
ALERT_EMAIL_TO=alerts@yourcompany.com

# Thresholds para alertas
ALERT_CIRCUIT_BREAKER_OPEN_THRESHOLD=3
ALERT_ERROR_RATE_THRESHOLD=15
ALERT_DEGRADATION_LEVEL_THRESHOLD=reduced
ALERT_BULKHEAD_UTILIZATION_THRESHOLD=90

# =============================================================================
# CONFIGURAÇÕES DE RATE LIMITING
# =============================================================================
RATE_LIMIT_FALLBACK_EXECUTION=100
RATE_LIMIT_FALLBACK_WINDOW=60000
RATE_LIMIT_ADMIN_OPERATIONS=10
RATE_LIMIT_ADMIN_WINDOW=60000

# =============================================================================
# CONFIGURAÇÕES DE RETRY GLOBAL
# =============================================================================
GLOBAL_RETRY_ENABLED=true
GLOBAL_RETRY_MAX_ATTEMPTS=3
GLOBAL_RETRY_BASE_DELAY=1000
GLOBAL_RETRY_MAX_DELAY=10000

# =============================================================================
# CONFIGURAÇÕES DE TIMEOUT GLOBAL
# =============================================================================
GLOBAL_TIMEOUT_ENABLED=true
GLOBAL_TIMEOUT_DEFAULT=30000
GLOBAL_TIMEOUT_HTTP_REQUEST=10000
GLOBAL_TIMEOUT_DATABASE_QUERY=5000
GLOBAL_TIMEOUT_CACHE_OPERATION=1000

# =============================================================================
# CONFIGURAÇÕES DE MONITORAMENTO
# =============================================================================
MONITORING_ENABLED=true
MONITORING_INTERVAL=10000
MONITORING_RETENTION_DAYS=7
MONITORING_ALERT_THRESHOLD=5

# APM (Application Performance Monitoring)
APM_ENABLED=false
APM_SERVICE_NAME=fallback-agent
APM_ENVIRONMENT=development
APM_SERVER_URL=http://localhost:8200

# =============================================================================
# CONFIGURAÇÕES DE TESTE
# =============================================================================
TEST_CIRCUIT_BREAKER_ENABLED=true
TEST_RETRY_ENABLED=true
TEST_DEGRADATION_ENABLED=true
TEST_BULKHEAD_ENABLED=true
TEST_MOCK_FAILURES=false
TEST_SIMULATION_MODE=false