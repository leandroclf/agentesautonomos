# =============================================================================
# MESSAGE SCHEMA REGISTRY - CONFIGURAÇÕES DE AMBIENTE
# =============================================================================
# Copie este arquivo para .env e configure as variáveis conforme necessário

# =============================================================================
# CONFIGURAÇÕES BÁSICAS DO SERVIÇO
# =============================================================================
NODE_ENV=development
SERVICE_VERSION=1.0.0
PORT=3022
HOST=0.0.0.0

# =============================================================================
# CONFIGURAÇÕES DE LOGGING
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/app.log
LOG_FILE_MAX_SIZE=20m
LOG_FILE_MAX_FILES=5
LOG_FILE_DATE_PATTERN=YYYY-MM-DD
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_COLORIZE=true

# =============================================================================
# CONFIGURAÇÕES DE SEGURANÇA
# =============================================================================
SECURITY_HELMET_ENABLED=true
SECURITY_CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true
SECURITY_RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SECURITY_COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024

# =============================================================================
# CONFIGURAÇÕES AWS
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# =============================================================================
# CONFIGURAÇÕES SQS
# =============================================================================
SQS_ENABLED=false
SQS_SCHEMA_EVENTS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/schema-events
SQS_SCHEMA_EVENTS_ENABLED=false
SQS_VALIDATION_EVENTS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/validation-events
SQS_VALIDATION_EVENTS_ENABLED=false
SQS_MIGRATION_EVENTS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/migration-events
SQS_MIGRATION_EVENTS_ENABLED=false
SQS_DLQ_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/schema-dlq
SQS_DLQ_ENABLED=false
SQS_CONSUMER_BATCH_SIZE=10
SQS_CONSUMER_WAIT_TIME=20
SQS_CONSUMER_VISIBILITY_TIMEOUT=300
SQS_CONSUMER_MAX_RETRIES=3

# =============================================================================
# CONFIGURAÇÕES DE SCHEMA
# =============================================================================
SCHEMA_STORAGE_TYPE=memory
SCHEMA_STORAGE_PATH=./data/schemas
SCHEMA_MAX_SCHEMAS=10000
SCHEMA_MAX_VERSIONS=100
SCHEMA_VALIDATION_STRICT=false
SCHEMA_ALLOW_ADDITIONAL_PROPS=true
SCHEMA_COERCE_TYPES=false
SCHEMA_REMOVE_ADDITIONAL=false
SCHEMA_JSON_ENABLED=true
SCHEMA_JSON_DRAFT=draft-07
SCHEMA_AVRO_ENABLED=true
SCHEMA_AVRO_NAMESPACE=com.example
SCHEMA_CACHE_ENABLED=true
SCHEMA_CACHE_TTL=3600
SCHEMA_CACHE_MAX_SIZE=1000

# =============================================================================
# CONFIGURAÇÕES DE VALIDAÇÃO
# =============================================================================
VALIDATION_TIMEOUT=5000
VALIDATION_BATCH_SIZE=100
VALIDATION_CACHE_ENABLED=true
VALIDATION_CACHE_COMPILED_MAX_SIZE=500
VALIDATION_CACHE_COMPILED_TTL=1800
VALIDATION_CUSTOM_ENABLED=true
VALIDATION_CUSTOM_TIMEOUT=1000
VALIDATION_TRANSFORMATIONS_ENABLED=true
VALIDATION_NORMALIZE=false
VALIDATION_SANITIZE=false
VALIDATION_ENRICH=false

# =============================================================================
# CONFIGURAÇÕES DE VERSIONAMENTO
# =============================================================================
VERSIONING_STRATEGY=semantic
VERSIONING_AUTO_INCREMENT=true
VERSIONING_DEPRECATION_ENABLED=true
VERSIONING_DEPRECATION_GRACE_PERIOD=2592000000
VERSIONING_TAGS_ENABLED=true
VERSIONING_AUTO_LATEST=true
VERSIONING_AUTO_STABLE=false

# =============================================================================
# CONFIGURAÇÕES DE COMPATIBILIDADE
# =============================================================================
COMPATIBILITY_DEFAULT_POLICY=BACKWARD
COMPATIBILITY_CACHE_ENABLED=true
COMPATIBILITY_CACHE_TTL=1800
COMPATIBILITY_CACHE_MAX_SIZE=1000
COMPATIBILITY_STRICT_TYPES=false
COMPATIBILITY_ALLOW_FIELD_ADDITION=true
COMPATIBILITY_ALLOW_FIELD_REMOVAL=false

# =============================================================================
# CONFIGURAÇÕES DE MIGRAÇÃO
# =============================================================================
MIGRATION_DEFAULT_STRATEGY=auto
MIGRATION_TIMEOUT=300000
MIGRATION_BATCH_SIZE=1000
MIGRATION_MAX_CONCURRENT=3
MIGRATION_RETRIES_ENABLED=true
MIGRATION_RETRIES_MAX_ATTEMPTS=3
MIGRATION_RETRIES_BACKOFF_MS=1000
MIGRATION_VALIDATION_ENABLED=true
MIGRATION_VALIDATION_STRICT=false

# =============================================================================
# CONFIGURAÇÕES DE CACHE
# =============================================================================
CACHE_MEMORY_ENABLED=true
CACHE_MEMORY_MAX_SIZE=1000
CACHE_MEMORY_TTL=3600
CACHE_DISTRIBUTED_ENABLED=false
CACHE_DISTRIBUTED_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=msr:
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
CACHE_CLEANUP_INTERVAL=300000

# =============================================================================
# CONFIGURAÇÕES DE MÉTRICAS
# =============================================================================
METRICS_ENABLED=true
METRICS_COLLECT_DEFAULT=true
METRICS_ENDPOINT=/metrics
METRICS_COLLECTION_INTERVAL=30000
PROMETHEUS_ENABLED=true
PROMETHEUS_PREFIX=msr_
PROMETHEUS_BUCKETS=0.1,0.5,1,2,5,10

# =============================================================================
# CONFIGURAÇÕES DE HEALTH CHECK
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_ENDPOINT=/health
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_MEMORY_THRESHOLD=80
HEALTH_DISK_THRESHOLD=90
HEALTH_RESPONSE_TIME_THRESHOLD=1000

# =============================================================================
# CONFIGURAÇÕES DE ALERTAS
# =============================================================================
ALERTS_ENABLED=false
ALERTS_PROCESSING_INTERVAL=5000
ALERTS_BATCH_SIZE=10
ALERTS_MAX_AGE=86400000
ALERTS_CLEANUP_INTERVAL=3600000

# Email Alerts
ALERTS_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ALERTS_EMAIL_FROM=noreply@example.com
ALERTS_EMAIL_RECIPIENTS=admin@example.com,ops@example.com

# Slack Alerts
ALERTS_SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#alerts
SLACK_USERNAME=Schema Registry
SLACK_ICON_EMOJI=:warning:

# PagerDuty Alerts
ALERTS_PAGERDUTY_ENABLED=false
PAGERDUTY_ROUTING_KEY=your_pagerduty_routing_key
PAGERDUTY_API_URL=https://events.pagerduty.com/v2/enqueue

# Webhook Alerts
ALERTS_WEBHOOK_ENABLED=false
ALERTS_WEBHOOK_URL=https://your-webhook-endpoint.com/alerts
ALERTS_WEBHOOK_AUTH=Bearer your_webhook_token
ALERTS_WEBHOOK_TIMEOUT=5000

# =============================================================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# =============================================================================
DEV_HOT_RELOAD=false
DEV_MOCK_SERVICES=false
DEBUG=false
DEV_PROFILING=false

# =============================================================================
# CONFIGURAÇÕES DE PRODUÇÃO
# =============================================================================
CLUSTER_ENABLED=false
CLUSTER_WORKERS=4
GRACEFUL_SHUTDOWN_ENABLED=true
GRACEFUL_SHUTDOWN_TIMEOUT=30000
PROCESS_TITLE=message-schema-registry

# =============================================================================
# CONFIGURAÇÕES DA API
# =============================================================================
API_DOCS_ENABLED=true
API_DEFAULT_LIMIT=20
API_MAX_LIMIT=100
API_REQUEST_TIMEOUT=30000
API_RESPONSE_TIMEOUT=30000

# =============================================================================
# CONFIGURAÇÕES DE BACKUP
# =============================================================================
BACKUP_ENABLED=false
BACKUP_INTERVAL=3600000
BACKUP_RETENTION_DAYS=7
BACKUP_LOCATION=./backups
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=false

# =============================================================================
# CONFIGURAÇÕES DE PERFORMANCE
# =============================================================================
MAX_CONCURRENT_VALIDATIONS=50
VALIDATION_TIMEOUT=10000
BATCH_VALIDATION_SIZE=10
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6

# =============================================================================
# CONFIGURAÇÕES DE TESTE
# =============================================================================
TEST_DATABASE_URL=memory://test
TEST_REDIS_URL=redis://localhost:6379/1
TEST_SQS_ENDPOINT=http://localhost:9324
TEST_TIMEOUT=30000

# =============================================================================
# CONFIGURAÇÕES DE MONITORAMENTO
# =============================================================================
MONITORING_ENABLED=true
TRACING_ENABLED=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# =============================================================================
# CONFIGURAÇÕES DE AUTENTICAÇÃO (FUTURO)
# =============================================================================
AUTH_ENABLED=false
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h
API_KEY_REQUIRED=false
API_KEY=your_api_key_here

# =============================================================================
# CONFIGURAÇÕES DE RATE LIMITING AVANÇADO
# =============================================================================
RATE_LIMIT_REDIS_ENABLED=false
RATE_LIMIT_REDIS_URL=redis://localhost:6379
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false
RATE_LIMIT_SKIP_FAILED_REQUESTS=false

# =============================================================================
# CONFIGURAÇÕES DE WEBHOOK
# =============================================================================
WEBHOOK_ENABLED=false
WEBHOOK_SECRET=your_webhook_secret
WEBHOOK_TIMEOUT=5000
WEBHOOK_RETRIES=3
WEBHOOK_RETRY_DELAY=1000

# =============================================================================
# CONFIGURAÇÕES DE FEATURE FLAGS
# =============================================================================
FEATURE_SCHEMA_EVOLUTION=true
FEATURE_AUTO_MIGRATION=false
FEATURE_SCHEMA_VALIDATION_CACHE=true
FEATURE_COMPATIBILITY_CHECK=true
FEATURE_VERSION_TAGGING=true
FEATURE_DEPRECATION_WARNINGS=true
FEATURE_METRICS_COLLECTION=true
FEATURE_HEALTH_CHECKS=true
FEATURE_ALERTING=false
FEATURE_BACKUP=false