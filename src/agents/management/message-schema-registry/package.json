{
  "name": "message-schema-registry",
  "version": "1.0.0",
  "description": "Sistema de registro e gerenciamento de esquemas de mensagens para agentes autônomos",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "validate": "npm run lint && npm run test",
    "build": "npm run validate",
    "docker:build": "docker build -t message-schema-registry .",
    "docker:run": "docker run -p 3022:3022 message-schema-registry",
    "docs:generate": "swagger-jsdoc -d swaggerDef.js -o swagger.json ./routes/*.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js"
  },
  "keywords": [
    "schema",
    "registry",
    "validation",
    "versioning",
    "compatibility",
    "migration",
    "microservices",
    "agents",
    "messaging",
    "json-schema",
    "avro",
    "protobuf"
  ],
  "author": "Sistema de Agentes Autônomos",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "swagger-ui-express": "^5.0.0",
    "swagger-jsdoc": "^6.2.8",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "ajv-keywords": "^5.1.0",
    "avsc": "^5.7.7",
    "protobufjs": "^7.2.5",
    "semver": "^7.5.4",
    "lodash": "^4.17.21",
    "uuid": "^9.0.1",
    "crypto": "^1.0.1",
    "aws-sdk": "^2.1489.0",
    "redis": "^4.6.10",
    "ioredis": "^5.3.2",
    "prom-client": "^15.0.0",
    "nodemailer": "^6.9.7",
    "axios": "^1.6.2",
    "joi": "^17.11.0",
    "express-validator": "^7.0.1",
    "multer": "^1.4.5-lts.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "moment": "^2.29.4",
    "cron": "^3.1.6",
    "node-cron": "^3.0.3",
    "fs-extra": "^11.1.1",
    "archiver": "^6.0.1",
    "unzipper": "^0.10.14",
    "csv-parser": "^3.0.0",
    "csv-writer": "^1.6.0",
    "yaml": "^2.3.4",
    "xml2js": "^0.6.2",
    "fast-json-stringify": "^5.8.0",
    "fast-json-parse": "^1.0.3",
    "lru-cache": "^10.0.2",
    "eventemitter3": "^5.0.1",
    "async": "^3.2.4",
    "p-queue": "^7.4.1",
    "p-retry": "^5.1.2",
    "p-timeout": "^6.1.2",
    "debug": "^4.3.4",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "inquirer": "^8.2.6",
    "commander": "^11.1.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.54.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "prettier": "^3.1.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.1.0",
    "@types/node": "^20.9.4",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "nock": "^13.4.0",
    "sinon": "^17.0.1",
    "nyc": "^15.1.0",
    "cross-env": "^7.0.3",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "docker-compose": "^0.24.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/message-schema-registry.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/message-schema-registry/issues"
  },
  "homepage": "https://github.com/your-org/message-schema-registry#readme",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/logs/**",
      "!**/dist/**",
      "!jest.config.js",
      "!server.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "eslintConfig": {
    "extends": [
      "standard"
    ],
    "env": {
      "node": true,
      "jest": true
    },
    "rules": {
      "no-console": "warn",
      "no-unused-vars": "error",
      "prefer-const": "error",
      "no-var": "error"
    }
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none",
    "printWidth": 100
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run test"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ]
  },
  "nodemonConfig": {
    "watch": [
      "."
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules/",
      "logs/",
      "coverage/",
      "dist/",
      "*.test.js",
      "*.spec.js"
    ],
    "env": {
      "NODE_ENV": "development",
      "DEBUG": "schema-registry:*"
    }
  }
}