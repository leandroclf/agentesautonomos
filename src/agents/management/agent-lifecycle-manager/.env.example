# Agent Lifecycle Manager - Variáveis de Ambiente

# =============================================================================
# CONFIGURAÇÕES DO SERVIDOR
# =============================================================================
PORT=3021
NODE_ENV=development
SERVICE_NAME=agent-lifecycle-manager
SERVICE_VERSION=1.0.0

# =============================================================================
# CONFIGURAÇÕES DE LOG
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
LOG_DATE_PATTERN=YYYY-MM-DD

# =============================================================================
# CONFIGURAÇÕES DE SEGURANÇA
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
API_KEY=your-api-key-for-internal-communication
ENCRYPTION_KEY=your-32-character-encryption-key
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# CONFIGURAÇÕES AWS
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_SQS_ENDPOINT=https://sqs.us-east-1.amazonaws.com

# =============================================================================
# CONFIGURAÇÕES SQS
# =============================================================================
SQS_QUEUE_LIFECYCLE_EVENTS=agent-lifecycle-events
SQS_QUEUE_HEALTH_CHECK_EVENTS=health-check-events
SQS_QUEUE_RECOVERY_EVENTS=recovery-events
SQS_QUEUE_FALLBACK_EVENTS=fallback-events
SQS_QUEUE_DLQ=agent-lifecycle-dlq
SQS_POLLING_WAIT_TIME=20
SQS_MAX_MESSAGES=10
SQS_VISIBILITY_TIMEOUT=300
SQS_MESSAGE_RETENTION=1209600
SQS_MAX_RETRIES=3
SQS_RETRY_DELAY=5000

# =============================================================================
# CONFIGURAÇÕES DE MONITORAMENTO
# =============================================================================
MONITORING_ENABLED=true
MONITORING_INTERVAL=30000
HEALTH_CHECK_INTERVAL=60000
HEALTH_CHECK_TIMEOUT=10000
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_RETRY_DELAY=2000

# =============================================================================
# CONFIGURAÇÕES DE LIFECYCLE
# =============================================================================
RESTART_MAX_ATTEMPTS=3
RESTART_DELAY=5000
RESTART_BACKOFF_FACTOR=2
GRACEFUL_SHUTDOWN_TIMEOUT=30000
STATE_PERSISTENCE_ENABLED=true
AUTO_RESTART_ENABLED=true
DEPENDENCY_CHECK_ENABLED=true

# =============================================================================
# CONFIGURAÇÕES DE DEPLOYMENT
# =============================================================================
DEPLOYMENT_STRATEGY=rolling
ROLLING_BATCH_SIZE=2
ROLLING_DELAY=5000
BLUE_GREEN_TEST_DURATION=30000
CANARY_PERCENTAGE=20
CANARY_DURATION=60000
CANARY_SUCCESS_THRESHOLD=0.95
ROLLBACK_ON_FAILURE=true
DEPLOYMENT_TIMEOUT=300000

# =============================================================================
# CONFIGURAÇÕES DE CACHE
# =============================================================================
CACHE_TYPE=memory
CACHE_TTL=300000
CACHE_MAX_SIZE=1000
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=lifecycle:

# =============================================================================
# CONFIGURAÇÕES DE MÉTRICAS
# =============================================================================
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics
PROMETHEUS_ENABLED=true
METRICS_COLLECTION_INTERVAL=15000

# =============================================================================
# CONFIGURAÇÕES DE ALERTAS
# =============================================================================
ALERT_ENABLED=true
ALERT_WEBHOOK_URL=https://your-webhook-url.com/alerts
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_HOST=smtp.gmail.com
ALERT_EMAIL_PORT=587
ALERT_EMAIL_USER=your-email@gmail.com
ALERT_EMAIL_PASS=your-email-password
ALERT_EMAIL_FROM=alerts@yourcompany.com
ALERT_EMAIL_TO=admin@yourcompany.com

# =============================================================================
# CONFIGURAÇÕES DE DEPENDÊNCIAS
# =============================================================================
HEALTH_CHECKER_URL=http://localhost:3015
RECOVERY_AGENT_URL=http://localhost:3019
FALLBACK_AGENT_URL=http://localhost:3020
PERSISTENCE_AGENT_URL=http://localhost:3018

# =============================================================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# =============================================================================
DEBUG_ENABLED=false
DEBUG_NAMESPACE=lifecycle:*
TEST_MODE=false
MOCK_EXTERNAL_SERVICES=false
DRY_RUN_MODE=false

# =============================================================================
# CONFIGURAÇÕES DE PERFORMANCE
# =============================================================================
MAX_CONCURRENT_OPERATIONS=10
OPERATION_TIMEOUT=60000
BATCH_PROCESSING_SIZE=5
THROTTLE_REQUESTS=true
THROTTLE_INTERVAL=1000

# =============================================================================
# CONFIGURAÇÕES DE BACKUP
# =============================================================================
BACKUP_ENABLED=true
BACKUP_INTERVAL=3600000
BACKUP_RETENTION_DAYS=7
BACKUP_LOCATION=./backups
BACKUP_COMPRESSION=true